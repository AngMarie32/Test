# ---- Server
PORT=3000
PUBLIC_URL=https://tradertaxhq.com
ADMIN_TOKEN=generate-a-long-random-string
APP_SECRET=another-long-random-string
TIMEZONE=America/New_York
# Set to "off" if you run jobs from cron / GitHub Actions with `npm run cli tick` instead
SCHEDULER=on

# ---- Brand / contact
BOOKING_URL=https://calendly.com/your-handle/trader-tax-strategy-call
FROM_EMAIL=hello@tradertaxhq.com
OWNER_EMAIL=you@tradertaxhq.com
MAILING_ADDRESS=TraderTax HQ, 123 Main St, Suite 100, Your City, ST 00000

# ---- AI content (Claude). Leave blank to use built-in templates.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_FALLBACKS=true

# ---- Compliance: every blog/newsletter/post waits for approval in /admin
REQUIRE_APPROVAL=true

# ---- Email: outbox (writes to data/outbox), resend, or postmark
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
POSTMARK_TOKEN=

# ---- Social: Zapier / Make / n8n / Buffer webhook(s). Blank = dry run.
SOCIAL_WEBHOOK_URL=
SOCIAL_WEBHOOK_URL_X=
SOCIAL_WEBHOOK_URL_LINKEDIN=
SOCIAL_WEBHOOK_URL_FACEBOOK=
SOCIAL_WEBHOOK_URL_INSTAGRAM=
SOCIAL_WEBHOOK_SECRET=

# ---- Calendly / Cal.com booking webhook: POST /api/webhooks/booking?secret=...
BOOKING_WEBHOOK_SECRET=
