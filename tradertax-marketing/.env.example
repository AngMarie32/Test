# ---- Server
PORT=3000
# Where THIS marketing app is hosted (e.g. a subdomain like go.tradertaxhq.com)
PUBLIC_URL=https://go.tradertaxhq.com
ADMIN_TOKEN=generate-a-long-random-string
APP_SECRET=another-long-random-string
TIMEZONE=America/New_York
# Set to "off" if you run jobs from cron with `npm run cli -- tick` instead
SCHEDULER=on

# ---- Free hosting (no disk): store data in a free Neon Postgres and let an external
# timer (cron-job.org) call GET /api/cron/tick?secret=CRON_SECRET every 10 minutes.
DATABASE_URL=
CRON_SECRET=

# ---- Main site
MAIN_SITE_URL=https://www.tradertaxhq.com
INTAKE_URL=https://www.tradertaxhq.com/get-started
# Origins allowed to POST to /api/subscribe and /api/leads (comma-separated)
ALLOWED_ORIGINS=https://www.tradertaxhq.com,https://tradertaxhq.com

# ---- Contact
FROM_EMAIL=info@tradertaxhq.com
OWNER_EMAIL=info@tradertaxhq.com
# Required by CAN-SPAM in every marketing email (PO box / private mailbox is fine)
MAILING_ADDRESS=TraderTaxHQ, PO Box 0000, City, ST 00000

# ---- AI content (Claude). Leave blank to use built-in templates.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_FALLBACKS=true

# ---- Compliance: every article/newsletter/post waits for approval in /admin
REQUIRE_APPROVAL=true

# ---- Email: outbox (writes to data/outbox), resend, or postmark
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
POSTMARK_TOKEN=

# ---- Social: Zapier / Make / n8n / Buffer webhook(s). Blank = dry run.
SOCIAL_WEBHOOK_URL=
SOCIAL_WEBHOOK_URL_X=
SOCIAL_WEBHOOK_URL_LINKEDIN=
SOCIAL_WEBHOOK_URL_FACEBOOK=
SOCIAL_WEBHOOK_URL_INSTAGRAM=
SOCIAL_WEBHOOK_SECRET=

# ---- Conversion webhooks: POST /api/webhooks/intake?secret=...  and  /api/webhooks/booking?secret=...
WEBHOOK_SECRET=
